{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "@config/*": ["config/*"],
      "@features/*": ["features/*/index", "features/*"],
      "@libs/*": ["libs/*"],
      "@models/*": ["models/*"],
      "@nui/*": ["nui/*"],
      "@utils/*": ["utils/*"],
      "@utils": ["utils/index"],
      "@shared/*": ["shared/*"],
      "@/*": ["*"],
      "@gql/*": ["../generated/gql/*"]
    }
  },
  "exclude": [
    "generated",
    "trash",
    "node_modules",
    "dist",
    "build",
    "vite.config.ts",
    "vite.config.js",
    "**/*.config.ts",
    "**/*.config.mts",
    "**/*.config.cts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
